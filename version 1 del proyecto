# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------
async def speak(text: str, voice: str = VOICE):
    """Read the text aloud with the Mac voice without blocking the bot."""
    process = await asyncio.create_subprocess_exec("say", "-v", voice, text)
    await process.wait()


async def reply(ctx: commands.Context, text: str, speak_aloud: bool = False,
                voice_text: str | None = None):
    """Send the text to the channel (max. 2000 characters) and optionally read it aloud."""
    await ctx.send(text[:2000])
    if speak_aloud:
        await speak(voice_text or text)


# ---------------------------------------------------------------------------
# Events
# ---------------------------------------------------------------------------
